{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "miniprogram-api-typings",
      "@miniprogramlab/core/globals"
    ],
    "lib": ["ES2022"]
  },
  "include": ["typechecks/**/*.ts", "fixtures/**/*.ts"]
}
