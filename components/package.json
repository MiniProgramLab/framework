    "@miniprogramlab/core": "workspace:*"
  },
  "peerDependencies": {
    "miniprogram-api-typings": ">=5.2.3",
    "@miniprogramlab/core": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "miniprogram": "src",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiniProgramLab/framework.git",
