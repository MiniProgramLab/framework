{
  "name": "@miniprogramlab/ui",
  "version": "0.1.0",
  "description": "基于 Skyline 的页面、弹层与弹动底栏组件",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
