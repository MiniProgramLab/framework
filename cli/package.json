{
  "name": "@miniprogramlab/cli",
  "version": "0.1.0",
  "description": "支持微信、抖音和支付宝适配器的小程序构建 CLI",
  "type": "module",
  "bin": {
    "miniprogram": "bin/miniprogram.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/options.d.ts",
      "default": "./dist/src/options.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json",
    "./register": "./bin/register.mjs"
  },
  "files": [
    "bin/miniprogram.mjs",
    "bin/register.mjs",
    "dist/bin/miniprogram.js",
    "dist/bin/miniprogram.js.map",
    "dist/bin/miniprogram.d.ts",
    "dist/src",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:check": "tsc -p tsconfig.json",
    "build": "pnpm dev:check",
    "prepack": "pnpm dev:check",
    "dev:test": "pnpm dev:check && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "esbuild": "catalog:",
    "less": "4.4.1",
    "sass": "catalog:",
    "typescript": "catalog:",
    "@miniprogramlab/core": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiniProgramLab/framework.git",
    "directory": "cli"
  },
  "devDependencies": {
    "@types/less": "^3.0.8",
    "@types/node": "^22.15.30"
  }
}
